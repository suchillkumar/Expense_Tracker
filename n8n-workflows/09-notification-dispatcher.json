              "value": "create_notification"
            },
            {
              "name": "userId",
              "value": "={{ $json.userId }}"
            },
            {
              "name": "logId",
              "value": "={{ $json.logId }}"
            },
            {
              "name": "data",
              "value": "={{ { message: $json.message, type: $json.type, category: $json.category, details: $json.details } }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Save In-App Notification",
